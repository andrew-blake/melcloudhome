# 3.14 for the latest-HA integration run and e2e; 3.13 for the HA-floor run
# (its pytest-homeassistant-custom-component won't install on 3.14).
# Base images are pinned by digest, one literal FROM per version so
# Dependabot's docker updater can read them; PYTHON_VERSION picks the stage
# and BuildKit skips the other.
ARG PYTHON_VERSION=3.14
FROM ghcr.io/astral-sh/uv:python3.14-bookworm-slim@sha256:7cf77f594be8042dab6daa9fe326f90962252268b4f120a7f5dccce4d947e6c1 AS base-3.14
FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim@sha256:531f855bda2c73cd6ef67d56b733b357cea384185b3022bd09f05e002cd144ca AS base-3.13
FROM base-${PYTHON_VERSION}

WORKDIR /app

# Install build tools for C extensions (needed for lru-dict in homeassistant)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency files first (change less frequently)
COPY pyproject.toml uv.lock ./

# Install dependencies using uv (includes test dependencies)
# This layer is cached unless pyproject.toml or uv.lock changes
RUN uv sync --frozen

# NOTE: the HA test package is NOT installed here. It includes pytest-socket,
# which blocks E2E tests, so integration runs install it at container start
# (pytest-homeassistant from ci/latest-ha/requirements.txt, or the floor's
# pytest-homeassistant-custom-component).

# Copy source code LAST (changes most frequently)
# Volume mounts will override these at runtime, but they're needed for uv sync to work
COPY custom_components ./custom_components
COPY tests ./tests
COPY tools ./tools

# Default command (run via uv)
CMD ["uv", "run", "pytest", "tests/", "-v"]
